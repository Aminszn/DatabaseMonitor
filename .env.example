
# Application
APP_NAME=Database Health Monitor
ENVIRONMENT=development

# API
API_HOST=127.0.0.1
API_PORT=8000

# Monitoring
MONITORING_INTERVAL_SECONDS=60

# Monitoring-history PostgreSQL database
# Replace with your actual development database URL when configured.
MONITORING_DATABASE_URL=

# Database timeouts
CONNECT_TIMEOUT_SECONDS=10
QUERY_TIMEOUT_SECONDS=30

# Logging
LOG_LEVEL=INFO
